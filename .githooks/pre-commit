#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

FILES=()

while IFS= read -r -d '' file; do
    case "${file}" in
        *.h|*.hpp|*.hh|*.c|*.cc|*.cpp|*.cxx)
            FILES+=("${file}")
            ;;
    esac
done < <(
    git diff \
        --cached \
        --name-only \
        --diff-filter=ACMR \
        -z
)

if [[ "${#FILES[@]}" -eq 0 ]]; then
    exit 0
fi

"${REPO_ROOT}/tools/formatter/format.sh" "${FILES[@]}"

git add -- "${FILES[@]}"