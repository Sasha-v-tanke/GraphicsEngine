{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/cmake-build-${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "GRAPHICS_ENGINE_BUILD_TESTS": "ON",
                "GRAPHICS_ENGINE_BUILD_SAMPLES": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "GraphicsEngine development build",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "GraphicsEngine optimized build",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "GRAPHICS_ENGINE_BUILD_TESTS": "OFF"
            }
        },
        {
            "name": "ci-base",
            "hidden": true,
            "inherits": "debug",
            "cacheVariables": {
                "GRAPHICS_ENGINE_BUILD_SAMPLES": "OFF",
                "GRAPHICS_ENGINE_WARNINGS_AS_ERRORS": "ON"
            }
        },
        {
            "name": "ci-small",
            "displayName": "CI Small",
            "description": "Backend-independent GraphicsEngine small test build",
            "inherits": "ci-base",
            "cacheVariables": {
                "GRAPHICS_ENGINE_BUILD_GLFW": "OFF",
                "GRAPHICS_ENGINE_BUILD_VULKAN": "OFF"
            }
        },
        {
            "name": "sanitizers",
            "displayName": "ASan + UBSan",
            "description": "GraphicsEngine sanitizer build",
            "inherits": "ci-small",
            "cacheVariables": {
                "GRAPHICS_ENGINE_BUILD_SAMPLES": "OFF",
                "GRAPHICS_ENGINE_ENABLE_ASAN": "ON",
                "GRAPHICS_ENGINE_ENABLE_UBSAN": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "ci-small",
            "configurePreset": "ci-small"
        },
        {
            "name": "sanitizers",
            "configurePreset": "sanitizers"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "ci-small",
            "configurePreset": "ci-small",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "sanitizers",
            "configurePreset": "sanitizers",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
