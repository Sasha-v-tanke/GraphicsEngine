set(directory "${BUILD_DIRECTORY}/metadata-fixture/metadata/GraphicsEngineMetadataGameplay")
set(source "${directory}/GraphicsEngineMetadataGameplay.gen.cpp")
set(header "${directory}/GraphicsEngineMetadataGameplay.gen.h")
set(manifest "${directory}/GraphicsEngineMetadataGameplay.manifest.json")
set(arguments --build "${BUILD_DIRECTORY}" --target GraphicsEngineMetadataConsumer)
if (TEST_CONFIG)
    list(APPEND arguments --config "${TEST_CONFIG}")
endif ()

function(run_build)
    execute_process(COMMAND "${CMAKE_COMMAND}" ${arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if (NOT result EQUAL 0)
        message(FATAL_ERROR "Incremental metadata build failed:\n${output}\n${error}")
    endif ()
    set(buildOutput "${output}${error}" PARENT_SCOPE)
endfunction()

run_build()
foreach (path IN ITEMS "${source}" "${header}" "${manifest}")
    file(SHA256 "${path}" hash)
    list(APPEND expected "${hash}")
endforeach ()
run_build()
if (buildOutput MATCHES "Generating metadata for")
    message(FATAL_ERROR "Unchanged build reran metadata generation")
endif ()
# Remove only a generated build artifact, never a user's declaration/source.
file(REMOVE "${source}")
run_build()
foreach (path IN ITEMS "${source}" "${header}" "${manifest}")
    file(SHA256 "${path}" hash)
    list(APPEND actual "${hash}")
endforeach ()
if (NOT actual STREQUAL expected)
    message(FATAL_ERROR "Regeneration changed deterministic metadata bytes")
endif ()
